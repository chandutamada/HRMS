# ==============================================================================
# HRMS APPLICATION - PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Copy to .env.production and fill in with your real production secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (MySQL 8.4 LTS)
# ------------------------------------------------------------------------------
DB_ROOT_PASSWORD=your_secure_root_password_here
DB_NAME=hrms_db
DB_USER=hrms_user
DB_PASSWORD=your_secure_database_password_here
DB_PORT=3306

# Prisma Database Connection URL
# For Docker Compose internal networking:
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@mysql:3306/${DB_NAME}"
# For direct host / external managed DB (e.g. AWS RDS, DigitalOcean):
# DATABASE_URL="mysql://hrms_user:your_secure_database_password_here@127.0.0.1:3306/hrms_db"

# ------------------------------------------------------------------------------
# 2. Server & API Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
API_PREFIX=/api
APP_URL="https://api-hr.superbeeaeronautics.com"
WEB_URL="https://hr.superbeeaeronautics.com"

# ------------------------------------------------------------------------------
# 3. Security, Encryption, JWT Authentication & Google OAuth
# ------------------------------------------------------------------------------
# Generate 64-byte random keys: openssl rand -base64 64
JWT_SECRET=replace_with_a_cryptographically_secure_random_jwt_secret_64_bytes
JWT_REFRESH_SECRET=replace_with_a_cryptographically_secure_random_refresh_secret_64_bytes
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0 Client ID (for Android App & Web Google Sign-In verification)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. Geofencing & Location Enforcement
# ------------------------------------------------------------------------------
# Set to 'true' to strictly enforce physical boundary on punch; 'false' records breach warnings
STRICT_GEOFENCE=true
DEFAULT_GEOFENCE_RADIUS_METERS=50
MAX_PERMISSIBLE_GPS_ACCURACY_METERS=100
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 5. Client Public Endpoints & Google Maps
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="https://api-hr.superbeeaeronautics.com/api"
NEXT_PUBLIC_WS_URL="https://api-hr.superbeeaeronautics.com"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyYourProductionGoogleMapsWebApiKey
GOOGLE_MAPS_SERVER_API_KEY=AIzaSyYourProductionGoogleMapsServerApiKey

# ------------------------------------------------------------------------------
# 6. CORS & Allowed Domains
# ------------------------------------------------------------------------------
CORS_ORIGIN="https://hr.superbeeaeronautics.com,https://api-hr.superbeeaeronautics.com"

# ------------------------------------------------------------------------------
# 7. File Storage (Face photos, payslip PDFs, avatars)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PRIVATE_DOCS_DIR=./storage/private_docs
PAYSLIPS_DIR=./storage/payslips

# ------------------------------------------------------------------------------
# 8. SMTP Email Service (Optional for alerts & reports)
# ------------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_mailgun_api_key
SMTP_FROM="HRMS System <no-reply@superbeeaeronautics.com>"
