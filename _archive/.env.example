# ==============================================================================
# HRMS APPLICATION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Configuration (MySQL 8.4 LTS)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="mysql://root:Chanduu@444444@localhost:3306/hrms_db"

# Server / API Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Security & JWT Tokens
JWT_SECRET=super_secret_hrms_jwt_access_key_2026_superbee_gtids_gtib!
JWT_REFRESH_SECRET=super_secret_hrms_jwt_refresh_key_2026_superbee_gtids_gtib_rotation!
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Google Maps Platform Configuration
# Note: Restrict client keys appropriately in Google Cloud Console
# For Web: HTTP referrer restriction (e.g., http://localhost:3000/*)
# For Android: Package name (com.hrms.mobile) and SHA-1 certificate fingerprint
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_WEB_API_KEY
GOOGLE_MAPS_SERVER_API_KEY=YOUR_GOOGLE_MAPS_SERVER_API_KEY

# Geofence & Location Defaults
DEFAULT_GEOFENCE_RADIUS_METERS=50
MAX_PERMISSIBLE_GPS_ACCURACY_METERS=100
TIMEZONE=Asia/Kolkata

# File Storage Configuration
STORAGE_DRIVER=local
UPLOAD_DIR=./storage/uploads
PRIVATE_DOCS_DIR=./storage/private_docs
PAYSLIPS_DIR=./storage/payslips

# SMTP Email Configuration (Optional - falls back to in-app notification logging)
SMTP_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HRMS Notifications <notifications@hrms.internal>"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:4000,http://10.0.2.2:4000
