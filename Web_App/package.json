{
  "name": "hrms-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise HRMS Application with Google Maps Geofencing (SUPERBEE, GTIDS, GTIB)",
  "workspaces": [
    "packages/database",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "db:generate": "npx prisma generate --schema=packages/database/prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=packages/database/prisma/schema.prisma",
    "db:seed": "npm --workspace=packages/database run db:seed",
    "api:dev": "npm --workspace=apps/api run start:dev",
    "api:build": "npm --workspace=apps/api run build",
    "api:test": "npm --workspace=apps/api run test",
    "web:dev": "npm --workspace=apps/web run dev",
    "web:build": "npm --workspace=apps/web run build"
  },
  "keywords": [
    "hrms",
    "nestjs",
    "nextjs",
    "flutter",
    "prisma",
    "mysql",
    "geofencing",
    "google-maps"
  ],
  "author": "",
  "license": "UNLICENSED"
}
